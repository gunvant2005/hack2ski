# LegalLens AI Environment Variables

# Database Setup (Defaults to SQLite if PostgreSQL is not running locally)
DATABASE_URL=sqlite:///./legallens.db
# For PostgreSQL + pgvector:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legallens_db

# Security & Authentication
JWT_SECRET=super-secret-legallens-jwt-key-2026-hackathon

# AI API Configurations (Optional: System falls back to local heuristic NLP engine if omitted)
LLM_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend public API endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api
